# Copy to .env on the server. Never commit the real file.

# --- core
PORT=3000
NODE_ENV=production
# staging = simulated drivers, dispatchNow honoured, orders released within a
# minute, TEST badge on tracking. Leave unset on production.
# DISPATCH_ENV=staging
DB_PATH=/var/lib/dispatch/dispatch.db
PUBLIC_URL=https://api.yourdomain.co.za

# --- routing
# Without this, distance is straight-line x 1.35 and every quote is marked
# "estimated". Fine for ranking dispatch candidates, not fine to bill on.
OSRM_URL=http://127.0.0.1:5000
OSRM_TIMEOUT_MS=2500

# --- keychat
KEYCHAT_WEBHOOK_URL=https://api.keychat.co.za/webhooks/delivery
KEYCHAT_SECRET=replace-with-a-long-random-string
CUSTOMER_DELIVERY_FEE=40

# --- pricing
# Buffer added to the ready-gate prediction, in minutes. Negative sends drivers
# early (they wait, food is hot), positive sends them late (food sits, drivers
# keep moving). Total friction is flat between about -2 and +2.
READY_BUFFER_MIN=0

# --- partner auth
# SHA-256 hashes of partner API keys, name:hash, comma-separated. Generate with
#   node scripts/new-partner-key.js keychat-test
# Empty = every /v1/keychat/* request is refused (fails closed).
PARTNER_API_KEYS=

# --- back-office logins
# Staff accounts live in the database, not here. Create the first admin with
#   node scripts/ops-user.js add --email you@feest.co.za --name "Your Name" --role admin
# then add the rest on the Staff tab. NODE_ENV=production marks the cookie Secure.
