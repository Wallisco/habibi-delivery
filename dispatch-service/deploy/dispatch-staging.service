[Unit]
Description=Dispatch service (STAGING, simulated drivers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dispatch
Group=dispatch
WorkingDirectory=/opt/dispatch-staging/dispatch-service
EnvironmentFile=/opt/dispatch-staging/dispatch-service/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# The database lives outside the repo so a deploy never touches it.
ReadWritePaths=/var/lib/dispatch-staging
StateDirectory=dispatch-staging

# Basic hardening. This process is internet-facing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dispatch-staging

[Install]
WantedBy=multi-user.target
