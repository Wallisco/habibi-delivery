  function select(which) {
    tabs.forEach(function (t) { $("tab-" + t).setAttribute("aria-selected", t === which); $("view-" + t).hidden = t !== which; });
    store("feest-tab", which);
    if (which === "kit") renderKit();
  }
  tabs.forEach(function (t) { $("tab-" + t).addEventListener("click", function () { select(t); }); });
  var h = location.hash.replace("#", ""), start = tabs.indexOf(h) >= 0 ? h : (load("feest-tab") || "compare");
  if (tabs.indexOf(start) < 0) start = "compare";

  renderCompare(); renderDriver(); renderKit(); select(start);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(renderKit);
  window.addEventListener("load", drawQRs);
})();
</script>

