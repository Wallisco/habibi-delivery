<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var num = function (id) { var v = parseFloat($(id).value); return isFinite(v) ? v : 0; };
  function grp(n) { return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " "); }
  function R(n) { return (n < 0 ? "−R " : "R ") + grp(Math.round(Math.abs(n))); }
  function R2(n) { var a = Math.abs(n), c = Math.round(a * 100), w = Math.floor(c / 100), d = c % 100; return (n < 0 ? "−R " : "R ") + grp(w) + "." + (d < 10 ? "0" : "") + d; }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function load(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

  /* ---------- pricing model (pure) ---------- */
  function marketplace(a, M, cpay) {
    var app = M * (1 + a.mk / 100);
    var small = app < a.thr ? a.sof : 0;
    var svc = app * a.svc / 100;
    var cust = app + a.del + svc + small;
    var rest = app * (1 - a.com / 100);
    return { cust: cust, menu: app, markup: app - M, fees: a.del + svc + small, rest: rest, courier: cpay, plat: cust - rest - cpay };
  }
  function feest(t, M, f) {
    var fee = M * t;
    var cust = M + f.del + (f.payer === "customer" ? fee : 0);
    var proc = cust * f.proc / 100;
    var rest = M - (f.payer === "restaurant" ? fee : 0) - (f.procBy === "restaurant" ? proc : 0);
    return { cust: cust, menu: M, markup: 0, fees: f.del + (f.payer === "customer" ? fee : 0), rest: rest, courier: f.cpay, plat: cust - rest - f.cpay, feestNet: cust - rest - f.cpay - (f.procBy === "feest" ? proc : 0) };
  }
  window.FEEST_MODEL = { marketplace: marketplace, feest: feest };

  var state = { tier: 0.15, payer: "customer", procBy: "feest", way: "1", logo: null, dishes: [], tc: {} };
  var tcEff = {};
  function tc(key, def) { tcEff[key] = state.tc[key] || def; return tcEff[key]; }
  function dish(i, style, label, onDark) {
    var src = state.dishes[i] || state.dishes[0];
    if (src) return '<div role="img" aria-label="Dish photo" style="' + style + ';background-image:url(' + src + ');background-size:cover;background-position:center"></div>';
    return '<div style="' + style + ';display:flex;align-items:center;justify-content:center;font-size:11px;font-family:JetBrains Mono,monospace;color:' + (onDark ? "#fff" : "#5B5470") + '">' + label + '</div>';
  }
  var lastCmp = "", lastDriver = "";
  var tip = $("tip");

  function segs(sel, attr, key) {
    document.querySelectorAll(sel).forEach(function (b) {
      b.addEventListener("click", function () {
        state[key] = attr === "data-tier" ? parseFloat(b.getAttribute(attr)) : b.getAttribute(attr);
        document.querySelectorAll(sel).forEach(function (x) { x.setAttribute("aria-pressed", x === b); });
        renderCompare(); if (key === "way") renderKit();
      });
    });
  }
  segs("[data-tier]", "data-tier", "tier");
  segs("[data-payer]", "data-payer", "payer");
  segs("[data-proc]", "data-proc", "procBy");
  segs("[data-way]", "data-way", "way");

  function renderCompare() {
    var M = num("m"), n = num("opd") * num("days"), cpay = num("cpay");
    var uber = marketplace({ mk: num("u-mk"), com: num("u-com"), del: num("u-del"), svc: num("u-svc"), sof: num("u-sof"), thr: num("u-thr") }, M, cpay);
    var mrd = marketplace({ mk: num("d-mk"), com: num("d-com"), del: num("d-del"), svc: num("d-svc"), sof: num("d-sof"), thr: num("d-thr") }, M, cpay);
    var f = { del: num("fdel"), cpay: cpay, proc: num("proc"), payer: state.payer, procBy: state.procBy };
    var tiers = [0.10, 0.15, 0.20];
    var cols = [{ name: "Uber Eats", r: uber }, { name: "Mr D", r: mrd }].concat(tiers.map(function (t) { return { name: "FEEST " + Math.round(t * 100) + "%", r: feest(t, M, f), t: t }; }));
    var sel = cols.filter(function (c) { return c.t === state.tier; })[0];

    // hero
    var dRest = (sel.r.rest - uber.rest) * n, dCust = uber.cust - sel.r.cust;
    $("h-rest").textContent = R(dRest);
    $("h-rest-s").textContent = sel.name + ": restaurant gets " + R2(sel.r.rest) + " per order vs " + R2(uber.rest) + " on Uber Eats";
    $("h-cust").textContent = R2(dCust);
    $("h-cust-s").textContent = "Customer pays " + R2(sel.r.cust) + " on " + sel.name + " vs " + R2(uber.cust) + " on Uber Eats";

    // chart: one scale for all rows
    var max = Math.max.apply(null, cols.map(function (c) { return c.r.cust; }));
    var html = "";
    cols.forEach(function (c) {
      var r = c.r, w = function (v) { return (Math.max(0, v) / max * 100).toFixed(2) + "%"; };
      html += '<div class="crow' + (c === sel ? " sel" : "") + '"><div class="nm">' + c.name + '</div><div class="track"><div class="bars" style="width:calc((100% - 86px) * ' + (r.cust / max).toFixed(4) + ')">' +
        '<div style="background:var(--s-rest);flex:' + Math.max(0, r.rest) + '" data-tip="' + c.name + " · Restaurant " + R2(r.rest) + '"></div>' +
        '<div style="background:var(--s-plat);flex:' + Math.max(0, r.plat) + '" data-tip="' + c.name + " · Platform " + R2(r.plat) + '"></div>' +
        '<div style="background:var(--s-cour);flex:' + Math.max(0, r.courier) + '" data-tip="' + c.name + " · Courier " + R2(r.courier) + '"></div>' +
        '</div><span class="tot">' + R2(r.cust) + '</span></div></div>';
    });
    $("chart").innerHTML = html;

    // table
    var rows = [
      ["Customer pays", function (r) { return R2(r.cust); }],
      ["…menu price on the app", function (r) { return R2(r.menu); }],
      ["…of which markup", function (r) { return R2(r.markup); }],
      ["…delivery and service fees", function (r) { return R2(r.fees); }],
      ["Restaurant receives", function (r) { return R2(r.rest); }],
      ["Restaurant keeps, % of in-store price", function (r) { return M > 0 ? Math.round(r.rest / M * 100) + "%" : "–"; }],
      ["Platform keeps (incl. payment fees)", function (r) { return R2(r.plat); }],
      ["Courier", function (r) { return R2(r.courier); }],
      ["Restaurant receives per month", function (r) { return R(r.rest * n); }]
    ];
    $("cmp").querySelectorAll("th[data-col]").forEach(function (th) { th.className = parseFloat(th.getAttribute("data-col")) === state.tier ? "sel" : ""; });
    $("cmp").querySelector("tbody").innerHTML = rows.map(function (row) {
      return "<tr><td>" + row[0] + "</td>" + cols.map(function (c) { return '<td class="' + (c === sel ? "sel" : "") + '">' + row[1](c.r) + "</td>"; }).join("") + "</tr>";
    }).join("");

    var w = $("c-warn");
    var losing = cols.filter(function (c) { return c.t && c.r.feestNet < 0; });
    if (losing.length) { w.hidden = false; w.textContent = "FEEST loses money per order at " + losing.map(function (c) { return c.name; }).join(", ") + ": fees don't cover courier pay and payment processing. Raise the delivery fee or lower courier pay."; }
