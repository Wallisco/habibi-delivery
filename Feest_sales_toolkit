<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>FEEST Sales Toolkit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Albert+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
/* Layout: brand header + four tabs (Compare, Brand kit, Sign up, Drivers); each tab is an inputs | results worksheet that stacks on phones */
:root {
  --bg: #F6F4FB;
  --surface: #FFFFFF;
  --ink: #170B3B;
  --muted: #5B5470;
  --line: #E4DFF0;
  --violet: #5B2EFF;
  --violet-soft: #ECE6FF;
  --coral: #FF5A36;
  --butter: #FFE7A3;
  --s-rest: #5B2EFF;
  --s-plat: #E8572F;
  --s-cour: #1F8F6E;
  --good-bg: #DDF3EA; --good-ink: #0E5A44;
  --warn-bg: #FFF1C9; --warn-ink: #6B4A00;
  --display: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
  --body: "Albert Sans", "Helvetica Neue", Arial, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #110A24; --surface: #1C1436; --ink: #F1EDFF; --muted: #B4ACD0; --line: #342A57;
    --violet: #9A84FF; --violet-soft: #2C2156; --coral: #FF7A55; --butter: #FFE7A3;
    --s-rest: #8468F2; --s-plat: #DC5A30; --s-cour: #279A79;
    --good-bg: #133A2E; --good-ink: #A6EBCF; --warn-bg: #4A3A0E; --warn-ink: #FFE29A;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #110A24; --surface: #1C1436; --ink: #F1EDFF; --muted: #B4ACD0; --line: #342A57;
  --violet: #9A84FF; --violet-soft: #2C2156; --coral: #FF7A55; --butter: #FFE7A3;
  --s-rest: #8468F2; --s-plat: #DC5A30; --s-cour: #279A79;
  --good-bg: #133A2E; --good-ink: #A6EBCF; --warn-bg: #4A3A0E; --warn-ink: #FFE29A;
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.5; }
.wrap { max-width: 1180px; margin: 0 auto; padding: 28px 18px 64px; display: flex; flex-direction: column; gap: 22px; }
header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
.wm { font-family: var(--display); font-weight: 800; letter-spacing: -.045em; line-height: 1; white-space: nowrap; }
.wm .roll { display: inline-block; transform: rotate(-34deg); color: var(--coral); }
.brandline { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
h1 { font-family: var(--display); font-size: clamp(26px, 4vw, 36px); line-height: 1.05; margin: 0; letter-spacing: -.02em; text-wrap: balance; }
.lede { color: var(--muted); max-width: 62ch; margin: 6px 0 0; }
.eyebrow, .group-title { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }
.tabs { display: flex; flex-wrap: wrap; gap: 4px; background: var(--surface); border: 1px solid var(--line); padding: 4px; border-radius: 999px; }
.tabs button { font: 600 15px var(--body); border: 0; background: transparent; color: var(--ink); padding: 10px 16px; border-radius: 999px; cursor: pointer; min-height: 44px; }
.tabs button[aria-selected="true"] { background: var(--violet); color: #fff; }
button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid var(--coral); outline-offset: 2px; }
.banner { background: var(--warn-bg); color: var(--warn-ink); border-radius: 12px; padding: 12px 16px; font-size: 14px; }
.grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 22px; align-items: start; }
@media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.panel h2 { font-family: var(--display); font-size: 22px; margin: 0; letter-spacing: -.01em; }
.panel h3 { font-family: var(--display); font-size: 18px; margin: 0; }
.group { display: flex; flex-direction: column; gap: 10px; }
.field { display: grid; grid-template-columns: minmax(0, 1fr) 128px; gap: 12px; align-items: center; }
.field.wide { grid-template-columns: minmax(0, 1fr); gap: 6px; }
.field label { font-size: 15px; }
.field label small { display: block; color: var(--muted); font-size: 13px; }
.inp { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); padding: 0 10px; min-height: 44px; }
.inp span { color: var(--muted); font-family: var(--mono); font-size: 13px; }
.inp input, .inp select { width: 100%; border: 0; background: transparent; color: var(--ink); font: 600 16px var(--mono); padding: 8px 4px; text-align: right; min-width: 0; }
.inp.text input, .inp select { text-align: left; font-family: var(--body); font-size: 15px; }
.inp input[type="color"] { height: 34px; padding: 0; cursor: pointer; }
.seg { display: flex; gap: 4px; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 4px; }
.seg button { flex: 1; font: 600 14px var(--body); border: 0; border-radius: 8px; background: transparent; color: var(--ink); min-height: 40px; cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.ph { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; background: var(--violet-soft); color: var(--ink); padding: 2px 6px; border-radius: 4px; margin-left: 4px; vertical-align: 2px; white-space: nowrap; }
details { border: 1px solid var(--line); border-radius: 12px; padding: 4px 14px; }
details[open] { padding-bottom: 14px; }
summary { cursor: pointer; font-weight: 700; min-height: 40px; display: flex; align-items: center; }
details .group { margin-top: 8px; }
.src { font-size: 13px; color: var(--muted); }
.src a { color: var(--violet); }
.hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 520px) { .hero { grid-template-columns: minmax(0, 1fr); } }
.stat { background: var(--bg); border-radius: 14px; padding: 16px; }
.stat .k { font-size: 13px; color: var(--muted); }
.stat .v { font-family: var(--display); font-size: clamp(26px, 4vw, 34px); font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
.stat .s { font-size: 13px; color: var(--muted); }
.stat.primary { background: var(--violet); color: #fff; }
.stat.primary .k, .stat.primary .s { color: #fff; opacity: .85; }
/* split chart */
.legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
.legend span { display: inline-flex; align-items: center; gap: 8px; }
.legend i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
.chart { display: flex; flex-direction: column; gap: 12px; }
.crow { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 12px; align-items: center; }
.crow .nm { font-size: 14px; font-weight: 600; }
.crow.sel .nm { color: var(--violet); }
.track { position: relative; display: flex; align-items: center; gap: 8px; }
.bars { display: flex; height: 26px; gap: 2px; }
.bars div { height: 100%; position: relative; cursor: default; }
.bars div:first-child { border-radius: 4px 0 0 4px; }
.bars div:last-child { border-radius: 0 4px 4px 0; }
.tot { font: 700 14px var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.tip { position: fixed; z-index: 10; pointer-events: none; background: var(--ink); color: var(--bg); font-size: 13px; padding: 8px 10px; border-radius: 8px; max-width: 240px; }
.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 620px; }
th, td { padding: 8px 6px; border-bottom: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
th:first-child, td:first-child { text-align: left; }
th { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--muted); font-weight: 500; text-transform: uppercase; }
th.sel { color: var(--violet); }
td { font-family: var(--mono); white-space: nowrap; }
td:first-child { white-space: normal; }
td:first-child { font-family: var(--body); }
td.sel { background: var(--violet-soft); font-weight: 700; }
.callout { border-radius: 12px; padding: 14px 16px; font-size: 15px; }
.callout.good { background: var(--good-bg); color: var(--good-ink); }
.callout.warn { background: var(--warn-bg); color: var(--warn-ink); }
.benefits { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.benefit { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
.benefit b { display: block; font-family: var(--display); font-size: 16px; margin-bottom: 2px; }
.benefit span { font-size: 14px; color: var(--muted); }
.actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.btn { font: 600 15px var(--body); border: 0; border-radius: 999px; padding: 11px 18px; min-height: 44px; cursor: pointer; background: var(--violet); color: #fff; }
.btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
.btn.small { padding: 8px 14px; min-height: 40px; font-size: 14px; }
.status { font-size: 14px; color: var(--muted); }
textarea.fallback { width: 100%; min-height: 120px; font: 13px var(--mono); border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); padding: 10px; }
.foot { color: var(--muted); font-size: 13px; }
/* brand kit */
.kitgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 18px; }
.kitcard { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.kitcard.full { grid-column: 1 / -1; }
.kithead { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
.kithead h3 { font-family: var(--display); font-size: 17px; margin: 0; }
.tcrow { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.tcpick { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 4px 6px 4px 12px; min-height: 40px; }
.tcpick input { width: 30px; height: 26px; border: 0; padding: 0; background: transparent; cursor: pointer; }
.kithead small { display: block; color: var(--muted); font-size: 13px; font-weight: 400; font-family: var(--body); }
.stage { overflow-x: auto; background: repeating-conic-gradient(var(--line) 0% 25%, transparent 0% 50%) 50% / 16px 16px; border-radius: 12px; padding: 16px; display: flex; justify-content: center; }
.uploadrow { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.logo-prev { width: 64px; height: 64px; border-radius: 12px; border: 1px dashed var(--line); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; }
.logo-prev img { max-width: 100%; max-height: 100%; }
.dish-prevs { display: flex; gap: 6px; min-height: 64px; align-items: center; }
.dish-prevs div { width: 64px; height: 64px; border-radius: 10px; background-size: cover; background-position: center; position: relative; }
.dish-prevs div span { position: absolute; left: 4px; top: 4px; background: rgba(0,0,0,.6); color: #fff; font: 700 11px var(--mono); border-radius: 4px; padding: 0 4px; }
.ways { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
.ways button { text-align: left; font: 600 14px var(--body); padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); cursor: pointer; min-height: 44px; }
.ways button[aria-pressed="true"] { border: 2px solid var(--violet); background: var(--violet-soft); }
/* print art: a fixed brand look, not themed */
.art { font-family: "Albert Sans", Arial, sans-serif; color: #170B3B; flex-shrink: 0; }
.art .wm .roll { color: #FF5A36; }
.monogram { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; font-family: "Bricolage Grotesque", Arial, sans-serif; font-weight: 800; letter-spacing: -.03em; }
.logoimg { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
.logobox { display: flex; align-items: center; justify-content: center; }
/* steps */
.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 12px; counter-reset: s; }
.steps li { counter-increment: s; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px 16px; }
.steps li::before { content: counter(s); display: inline-flex; width: 28px; height: 28px; border-radius: 50%; background: var(--violet); color: #fff; font: 700 14px var(--mono); align-items: center; justify-content: center; margin-bottom: 8px; }
.steps b { display: block; font-family: var(--display); font-size: 17px; }
.steps span { font-size: 14px; color: var(--muted); }
.check { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; min-height: 32px; }
.check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--violet); }
</style>

<div class="wrap">
  <header>
    <div>
      <div class="brandline"><span class="wm" style="font-size:44px">fe<span class="roll">e</span>st</span><span class="eyebrow">Sales toolkit</span></div>
      <h1>FEEST Sales Toolkit</h1>
      <p class="lede">Compare FEEST with Uber Eats and Mr D on the restaurant's own numbers, build their branded kit on the spot, and sign them up.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Toolkit sections">
      <button role="tab" id="tab-compare" aria-selected="true" aria-controls="view-compare">Compare</button>
      <button role="tab" id="tab-kit" aria-selected="false" aria-controls="view-kit">Brand kit</button>
      <button role="tab" id="tab-signup" aria-selected="false" aria-controls="view-signup">Sign up</button>
      <button role="tab" id="tab-driver" aria-selected="false" aria-controls="view-driver">Drivers</button>
    </div>
  </header>

  <!-- ============ COMPARE ============ -->
  <section id="view-compare" role="tabpanel" aria-labelledby="tab-compare" class="grid">
    <div class="panel">
      <h2>The restaurant's order</h2>
      <div class="group">
        <div class="field"><label for="m">Order at in-store menu prices<small>Food only</small></label><div class="inp"><span>R</span><input id="m" type="number" inputmode="decimal" min="0" step="5" value="180"></div></div>
        <div class="field"><label for="opd">Delivery orders per day</label><div class="inp"><input id="opd" type="number" inputmode="decimal" min="0" step="1" value="25"></div></div>
        <div class="field"><label for="days">Trading days per month</label><div class="inp"><input id="days" type="number" inputmode="decimal" min="0" max="31" step="1" value="26"></div></div>
      </div>
      <div class="group">
        <div class="group-title">FEEST terms</div>
        <div class="field wide"><label>Service fee to show<small>All three tiers stay in the table</small></label>
          <div class="seg" role="group" aria-label="FEEST service fee tier"><button type="button" data-tier="0.10" aria-pressed="false">10%</button><button type="button" data-tier="0.15" aria-pressed="true">15%</button><button type="button" data-tier="0.20" aria-pressed="false">20%</button></div></div>
        <div class="field wide"><label>Service fee paid by<small>A % of menu price. Customer pays it like an app service fee; or the restaurant pays it as a commission.</small></label>
          <div class="seg" role="group" aria-label="Who pays the service fee"><button type="button" data-payer="customer" aria-pressed="true">Customer</button><button type="button" data-payer="restaurant" aria-pressed="false">Restaurant</button></div></div>
        <div class="field"><label for="fdel">FEEST delivery fee <span class="ph">PLACEHOLDER</span><small>Customer pays, on top</small></label><div class="inp"><span>R</span><input id="fdel" type="number" inputmode="decimal" min="0" step="1" value="25"></div></div>
        <div class="field"><label for="cpay">Courier pay per delivery <span class="ph">PLACEHOLDER</span><small>Used for all platforms</small></label><div class="inp"><span>R</span><input id="cpay" type="number" inputmode="decimal" min="0" step="1" value="30"></div></div>
        <div class="field"><label for="proc">Payment processing<small>Keychat rate: 3%</small></label><div class="inp"><input id="proc" type="number" inputmode="decimal" min="0" max="20" step="0.1" value="3"><span>%</span></div></div>
        <div class="field wide"><label>Payment processing paid by</label>
          <div class="seg" role="group" aria-label="Who pays payment processing"><button type="button" data-proc="feest" aria-pressed="true">FEEST</button><button type="button" data-proc="restaurant" aria-pressed="false">Restaurant</button></div></div>
      </div>
      <details>
        <summary>Uber Eats assumptions</summary>
        <div class="group">
          <div class="field"><label for="u-mk">Menu markup on the app<small>Reported 14–40%, mostly about 25%</small></label><div class="inp"><input id="u-mk" type="number" inputmode="decimal" min="0" step="1" value="25"><span>%</span></div></div>
          <div class="field"><label for="u-com">Commission to Uber<small>Reported 25–35%</small></label><div class="inp"><input id="u-com" type="number" inputmode="decimal" min="0" max="100" step="1" value="30"><span>%</span></div></div>
          <div class="field"><label for="u-del">Delivery fee<small>Varies by distance</small></label><div class="inp"><span>R</span><input id="u-del" type="number" inputmode="decimal" min="0" step="1" value="15"></div></div>
          <div class="field"><label for="u-svc">Service fee to customer<small>About 4% in 2024 tests</small></label><div class="inp"><input id="u-svc" type="number" inputmode="decimal" min="0" step="0.5" value="4"><span>%</span></div></div>
          <div class="field"><label for="u-sof">Small order fee</label><div class="inp"><span>R</span><input id="u-sof" type="number" inputmode="decimal" min="0" step="1" value="5"></div></div>
          <div class="field"><label for="u-thr">…on app orders under <span class="ph">ESTIMATE</span></label><div class="inp"><span>R</span><input id="u-thr" type="number" inputmode="decimal" min="0" step="10" value="100"></div></div>
        </div>
      </details>
      <details>
        <summary>Mr D assumptions</summary>
        <div class="group">
          <div class="field"><label for="d-mk">Menu markup on the app<small>Reported 25–38%</small></label><div class="inp"><input id="d-mk" type="number" inputmode="decimal" min="0" step="1" value="27"><span>%</span></div></div>
          <div class="field"><label for="d-com">Commission to Mr D<small>Reported 15–35%, often about 30%</small></label><div class="inp"><input id="d-com" type="number" inputmode="decimal" min="0" max="100" step="1" value="30"><span>%</span></div></div>
          <div class="field"><label for="d-del">Delivery fee<small>Flat R15 in 2024 tests</small></label><div class="inp"><span>R</span><input id="d-del" type="number" inputmode="decimal" min="0" step="1" value="15"></div></div>
          <div class="field"><label for="d-svc">Service fee to customer</label><div class="inp"><input id="d-svc" type="number" inputmode="decimal" min="0" step="0.5" value="0"><span>%</span></div></div>
          <div class="field"><label for="d-sof">Small order fee</label><div class="inp"><span>R</span><input id="d-sof" type="number" inputmode="decimal" min="0" step="1" value="0"></div></div>
          <div class="field"><label for="d-thr">…on app orders under</label><div class="inp"><span>R</span><input id="d-thr" type="number" inputmode="decimal" min="0" step="10" value="0"></div></div>
        </div>
      </details>
      <p class="src">Uber Eats and Mr D don't publish their SA commissions. Defaults are estimates from press tests and reports: <a href="https://mybroadband.co.za/news/it-services/599120-hidden-price-increase-when-buying-food-through-mr-d-and-uber-eats.html" target="_blank" rel="noopener">MyBroadband, Jun 2025 (markups)</a>, <a href="https://www.financialmail.businessday.co.za/features/2025-11-27-why-your-delivered-meals-and-groceries-cost-more-than-you-think/" target="_blank" rel="noopener">Financial Mail, Nov 2025 (commissions)</a>, <a href="https://mybroadband.co.za/news/it-services/554132-we-raced-uber-eats-and-mr-d-to-kfc-and-back.html" target="_blank" rel="noopener">MyBroadband, Aug 2024 (fees)</a>, <a href="https://mybroadband.co.za/news/it-services/528749-mr-d-beats-uber-eats-in-food-delivery-price-shootout.html" target="_blank" rel="noopener">MyBroadband, Mar 2024 (fees)</a>, <a href="https://wanguapp.com/blog/uber-eats-fees-south-africa" target="_blank" rel="noopener">Wangu, Mar 2026 (commissions)</a>. Ask each restaurant for its real rates.</p>
    </div>

    <div class="panel" aria-live="polite">
      <h2>Same food, three ways to sell it</h2>
      <div class="hero">
        <div class="stat primary"><div class="k">Restaurant keeps more per month vs Uber Eats</div><div class="v" id="h-rest">–</div><div class="s" id="h-rest-s"></div></div>
        <div class="stat"><div class="k">Customer pays less per order vs Uber Eats</div><div class="v" id="h-cust">–</div><div class="s" id="h-cust-s"></div></div>
      </div>
